ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace-with-long-random-secret
DATABASE_URL=postgresql+psycopg://user:password@host:5432/smart_market
CORS_ORIGINS=https://your-domain.example
GOOGLE_MAPS_API_KEY=
SESSION_TTL_HOURS=24
RATE_LIMIT_PER_MINUTE=120
# Required in production; use a private Redis instance with TLS/authentication.
# Replace this placeholder before deployment.
REDIS_URL=rediss://:<password>@<host>:<port>/0
RATE_LIMIT_NAMESPACE=smart-market:api-rate-limit

# Optional: Firecrawl API for permitted public web discovery
FIRECRAWL_API_KEY=
DIVAR_API_KEY=
DISCOVERY_TIMEOUT_SECONDS=15
DISCOVERY_MAX_RESULTS=20
# Optional default market. Leave empty to require an explicit market per operation.
DEFAULT_MARKET_NAME=

DISCOVERY_REQUEST_BUDGET=50
DISCOVERY_CACHE_TTL_SECONDS=900
DISCOVERY_MAX_RETRIES=3
DISCOVERY_GLOBAL_REQUESTS_PER_MINUTE=120
DISCOVERY_SOURCE_REQUESTS_PER_MINUTE=30
DISCOVERY_USER_REQUESTS_PER_MINUTE=60
DISCOVERY_WORKER_POLL_SECONDS=2
